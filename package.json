{
  "name": "that-space",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:beta": "vitest run tests/integration/local-beta.test.ts",
    "test:watch": "vitest",
    "seed:samples": "tsx --env-file=.env.local scripts/seed-samples.ts",
    "discourse:install": "tsx --env-file=.env.local scripts/install-discourse-ai.ts",
    "discourse:probe": "tsx --env-file=.env.local scripts/probe-discourse.ts"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.14",
    "linkify-it": "^6.1.0",
    "next": "15.5.27",
    "postgres": "^3.4.9",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.27",
    "jsdom": "^25.0.1",
    "postcss": "8.5.28",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "2.1.9"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
