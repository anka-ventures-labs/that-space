# Bà Mối service environment. Copy to .env.local (gitignored) and fill in.
# Never commit real values. Vercel gets the runtime ones at deploy time.

# ── Runtime (Vercel + local scripts) ──────────────────────────────────────
# Public support contact. Commit only the variable name, never a personal value.
PUBLIC_SUPPORT_EMAIL=

# Publish the Discourse community/login links only after the live member path
# has passed acceptance from outside the operator network. DISCOURSE_URL alone
# is intentionally insufficient so a private or stale endpoint is never linked.
PUBLIC_COMMUNITY_LINK_ENABLED=false

# Publish the direct Discourse /signup CTA only after Google OAuth and the
# self-service acceptance path pass on the live forum.
COMMUNITY_PUBLIC_REGISTRATION_ENABLED=false

# Master switch for every Bà Mối tool, webhook and retry route. Production sets
# this true for the full-feature launch; false remains the emergency stop.
BA_MOI_ENABLED=false

# Supabase transaction pooler (Supavisor, port 6543), password percent-encoded:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Tool calls from the Bà Mối persona send `Authorization: Bearer <this>`. 32+ random characters.
BA_MOI_TOOL_SECRET=
# The Discourse webhook's secret (Admin > API > Webhooks). 16+ characters.
DISCOURSE_WEBHOOK_SECRET=
# Supabase pg_cron calls /api/ba-moi/v1/cron/retry-posts with `Authorization: Bearer <this>`. 32+ characters.
CRON_SECRET=
# The forum's base URL, and one single-user API key per bot user (Admin > API >
# New key > User level: single user). A leaked key can only post as its bot.
DISCOURSE_URL=
DISCOURSE_PERSONA_API_KEY=
DISCOURSE_RELAY_API_KEY=
# The bot users. Their Discourse user ids (comma-separated) are never relayed.
BA_MOI_PERSONA_USERNAME=ba_moi
BA_MOI_RELAY_USERNAME=thu_duyen
BA_MOI_BOT_USER_IDS=

# ── Install only (`npm run discourse:install`); never set in Vercel ──────
# An all-users admin API key, used only from a trusted machine to install the
# tools, the secret and the agent. Revoke it after installing.
DISCOURSE_ADMIN_API_KEY=
DISCOURSE_ADMIN_USERNAME=system
# The deployed service, e.g. https://<project>.vercel.app/api/ba-moi/v1
BA_MOI_SERVICE_URL=
# Discourse LLM id and the group ids allowed to talk to Bà Mối. The public
# launch includes trust_level_0 so every registered adult can use the agent.
BA_MOI_LLM_ID=
BA_MOI_ALLOWED_GROUP_IDS=

# ── Supabase CLI only (`supabase link`, `supabase db push`) ──────────────
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
